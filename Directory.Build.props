<Project>
  <!--
    Shared build settings for every .NET project in the repository.
    Keep project files minimal; anything that applies to all projects belongs here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Maple Notes</Product>
    <Authors>Maple Notes contributors</Authors>
    <Copyright>Copyright (c) 2026 Maple Notes contributors</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
