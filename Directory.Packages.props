<Project>
  <!--
    Central package management: every NuGet version is pinned here, projects reference packages without versions.
    Before adding a package, check its license against docs/licensing.md and run scripts/check-licenses.py.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Server">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- SQLite with SQLCipher-format encryption (MIT). Replaces the discontinued SQLitePCLRaw.bundle_e_sqlcipher. -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>
</Project>
